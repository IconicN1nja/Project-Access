# =============================================================================
# Project Access - Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# ── Vector Database (Qdrant Cloud) ──────────────────────────────────────────
QDRANT_URL=https://your-cluster.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key
# Optional: extra keys for failover / rate-limit rotation (GROQ_API_KEY1..N)
# GROQ_API_KEY1=gsk_...
# GROQ_API_KEY2=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# ── Database & Authentication ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/access?appName=Cluster
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (SMTP for verification) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="Project Access <you@gmail.com>"

# ── Backend Integration (optional, defaults to localhost:8000) ──────────────
RAG_API_URL=http://127.0.0.1:8000/api/query